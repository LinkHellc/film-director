new file mode 100644
index 0000000..29dc458
--- /dev/null
+++ b/scripts/py/frames.py
@@ -0,0 +1,165 @@
+"""抽帧、居中裁 16:9、首尾帧对比。
+
+  frames.py extract <视频> <输出目录> [--every 0.5]
+  frames.py extract <视频> <输出目录> --around 2.0,5.0 [--n 3]
+      --every：从 0 秒起每隔几秒取一帧（默认 0.5）。
+      --around：在每个时间点所在的那一帧前后各取 n 帧（相邻帧，按视频帧率），共 2n+1 张；多个点用逗号隔开。
+      文件名 t<毫秒7位>ms.png。输出目录可以已存在，但要写的任一文件已存在就整个拒绝、一张也不写。
+  frames.py crop169 <输入png> <输出png>
+      居中裁成 16:9（宽了裁左右，高了裁上下）。
+  frames.py compare <首帧> <尾帧> <输出png>
+      左边 50% 叠加图、右边差值图（拉满对比度方便看）；按 8×8 网格打印差异最大的 5 格。
+输出已存在则拒绝（退出码 2），原文件不动。ffmpeg 位置见 common.py。
+"""
+import argparse
+from pathlib import Path
+
+from PIL import Image, ImageChops, ImageOps
+
+from common import Fail, ffmpeg, ffprobe_json, main_wrapper, need_input, need_new, save_image_new
+
+GRID = 8
+
+
+def video_info(path):
+    info = ffprobe_json(path)
+    v = next((s for s in info.get("streams", []) if s.get("codec_type") == "video"), None)
+    if v is None:
+        raise Fail(f"{Path(path).name} 里没有视频流。")
+    num, _, den = (v.get("avg_frame_rate") or v.get("r_frame_rate") or "0/1").partition("/")
+    fps = float(num) / float(den or 1) if float(den or 1) else 0.0
+    duration = float(v.get("duration") or info.get("format", {}).get("duration") or 0)
+    if fps <= 0 or duration <= 0:
+        raise Fail(f"读不出 {Path(path).name} 的帧率或时长。")
+    return fps, duration
+
+
+def plan_times(fps, duration, every=None, around=None, n=3):
+    """返回要取的帧序号（升序、去重）。"""
+    last = max(0, int(duration * fps + 1e-6) - 1)  # 最后一帧的序号
+    idx = set()
+    if around is not None:
+        for t in around:
+            c = min(last, max(0, round(t * fps)))
+            idx.update(i for i in range(c - n, c + n + 1) if 0 <= i <= last)
+    else:
+        k = 0
+        while k * every < duration - 1e-6:
+            idx.add(min(last, round(k * every * fps)))
+            k += 1
+    return sorted(idx)
+
+
+def cmd_extract(a):
+    src = need_input(a.video)
+    if a.every is not None and a.around is not None:
+        raise Fail("--every 和 --around 只能选一个。")
+    around = None
+    if a.around is not None:
+        try:
+            around = [float(x) for x in a.around.split(",") if x.strip()]
+        except ValueError:
+            raise Fail(f"--around 要写成逗号分隔的秒数，比如 2.0,5.0，收到 {a.around!r}。")
+        if not around or a.n < 0:
+            raise Fail("--around 至少给一个时间点，--n 不能是负数。")
+    every = a.every if a.every is not None else 0.5
+    if every <= 0:
+        raise Fail("--every 必须大于 0。")
+    fps, duration = video_info(src)
+    frames = plan_times(fps, duration, every, around, a.n)
+    out_dir = Path(a.out_dir)
+    targets = [(i, out_dir / f"t{round(i / fps * 1000):07d}ms.png") for i in frames]
+    clash = [p for _, p in targets if p.exists()]
+    if clash:
+        raise Fail(f"输出已存在，不覆盖：{clash[0]}（共 {len(clash)} 张重名）。")
+    out_dir.mkdir(parents=True, exist_ok=True)
+    for i, path in targets:
+        # 往前让 0.25 帧再 seek：ffmpeg 取第一个时间戳 ≥ ss 的帧，正好是第 i 帧
+        ss = max(0.0, (i - 0.25) / fps)
+        ffmpeg(["-ss", f"{ss:.6f}", "-i", src, "-frames:v", "1", "-update", "1", path], f"抽第 {i} 帧")
+    print(f"已抽 {len(targets)} 帧到 {out_dir}")
+    return 0
+
+
+def crop_box_169(w, h):
+    if w * 9 > h * 16:
+        cw = round(h * 16 / 9)
+        left = (w - cw) // 2
+        return left, 0, left + cw, h
+    ch = round(w * 9 / 16)
+    top = (h - ch) // 2
+    return 0, top, w, top + ch
+
+
+def open_rgb(path):
+    try:
+        with Image.open(need_input(path)) as im:
+            return im.convert("RGB")
+    except OSError:
+        raise Fail(f"读不出图片：{path}。")
+
+
+def cmd_crop169(a):
+    need_new(a.output)
+    img = open_rgb(a.input)
+    out = img.crop(crop_box_169(*img.size))
+    save_image_new(out, a.output)
+    print(f"已裁成 {out.width}×{out.height}：{a.output}")
+    return 0
+
+
+def top_cells(diff_gray, k=5):
+    """8×8 网格里平均差异（0–1）最大的 k 格：[(行, 列, 差异)]，行列从 1 起。"""
+    w, h = diff_gray.size
+    cells = []
+    for r in range(GRID):
+        for c in range(GRID):
+            box = (c * w // GRID, r * h // GRID, (c + 1) * w // GRID, (r + 1) * h // GRID)
+            cell = diff_gray.crop(box)
+            hist = cell.histogram()
+            total = sum(hist) or 1
+            cells.append((r + 1, c + 1, sum(v * n for v, n in enumerate(hist)) / total / 255))
+    cells.sort(key=lambda x: (-x[2], x[0], x[1]))
+    return cells[:k]
+
+
+def cmd_compare(a):
+    need_new(a.output)
+    first, last = open_rgb(a.first), open_rgb(a.last)
+    if last.size != first.size:
+        last = last.resize(first.size, Image.LANCZOS)
+    overlay = Image.blend(first, last, 0.5)
+    diff = ImageChops.difference(first, last)
+    cells = top_cells(diff.convert("L"))
+    sheet = Image.new("RGB", (first.width * 2, first.height))
+    sheet.paste(overlay, (0, 0))
+    sheet.paste(ImageOps.autocontrast(diff), (first.width, 0))
+    save_image_new(sheet, a.output)
+    print(f"差异最大的 5 格（8×8 网格，0–1）已画到 {a.output}：")
+    for r, c, v in cells:
+        print(f"第{r}行第{c}列 差异 {v:.3f}")
+    return 0
+
+
+def main():
+    ap = argparse.ArgumentParser(description="抽帧、裁 16:9、首尾帧对比")
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    e = sub.add_parser("extract")
+    e.add_argument("video")
+    e.add_argument("out_dir")
+    e.add_argument("--every", type=float)
+    e.add_argument("--around")
+    e.add_argument("--n", type=int, default=3)
+    c = sub.add_parser("crop169")
+    c.add_argument("input")
+    c.add_argument("output")
+    m = sub.add_parser("compare")
+    m.add_argument("first")
+    m.add_argument("last")
+    m.add_argument("output")
+    a = ap.parse_args()
+    return {"extract": cmd_extract, "crop169": cmd_crop169, "compare": cmd_compare}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main_wrapper(main)
diff --git a/scripts/py/grayscale.py b/scripts/py/grayscale.py
new file mode 100644
index 0000000..c877b6a
--- /dev/null
+++ b/scripts/py/grayscale.py
@@ -0,0 +1,100 @@
+"""黑白检查：转灰度存图，并检查每个色块和周围背景的明暗差。
+
+用法：python grayscale.py <输入png> <输出png> [--board 分镜JSON] [--min-contrast 0.25]
+
+不给 --board 时只转灰度。给了 --board（格式见 sketch.py）时，对每个色块取块内亮度中位数、
+块外一圈（向外扩块宽高的 25%，不含其他色块）的亮度中位数，差值除以 255 得 0–1，
+低于阈值的逐条列出，退出码 1 表示"明暗对比不够"；全部够则退出 0。
+
+色块位置怎么对到图上：
+  - 分镜只有 1 个镜头且图是 16:9 → 整张图就是这一镜；
+  - 否则按 sketch.py 的总表排法（每行 3 张、每张 16:9）切格子，第 i 个镜头对应第 i 格。
+输出已存在则拒绝（退出码 2），原文件不动。
+"""
+import argparse
+import math
+import statistics
+
+from PIL import Image
+
+from common import Fail, main_wrapper, need_input, need_new, save_image_new
+from sketch import COLS, block_box, load_board
+
+
+def frames_for(img, shots):
+    """返回每个镜头在图上的区域 (left, top, w, h)。"""
+    W, H = img.size
+    if len(shots) == 1 and abs(W / H - 16 / 9) < 0.02:
+        return [(0, 0, W, H)]
+    tw = W / COLS
+    th = tw * 9 / 16
+    rows = math.ceil(len(shots) / COLS)
+    if abs(rows * th - H) > 2:
+        raise Fail(f"图的尺寸 {W}×{H} 和 {len(shots)} 个镜头的草图总表对不上。")
+    return [(round((i % COLS) * tw), round((i // COLS) * th), round(tw), round(th)) for i in range(len(shots))]
+
+
+def median_in(gray, boxes, exclude):
+    """boxes 里所有像素、去掉落在 exclude 框里的，取亮度中位数；没有像素返回 None。"""
+    px = gray.load()
+    vals = []
+    for x0, y0, x1, y1 in boxes:
+        for y in range(y0, y1):
+            for x in range(x0, x1):
+                if not any(e[0] <= x < e[2] and e[1] <= y < e[3] for e in exclude):
+                    vals.append(px[x, y])
+    return statistics.median(vals) if vals else None
+
+
+def check(gray, shots, min_contrast):
+    """返回 [(镜头, 标签, 对比度)]，只含低于阈值的块。对比度在缩小到每镜宽 ≤320 的图上算，够准也够快。"""
+    low = []
+    for shot, (L, T, w, h) in zip(shots, frames_for(gray, shots)):
+        frame = gray.crop((L, T, L + w, T + h))
+        scale = min(1.0, 320 / w)
+        fw, fh = max(1, round(w * scale)), max(1, round(h * scale))
+        frame = frame.resize((fw, fh), Image.BOX)
+        boxes = [block_box(b, fw, fh) for b in shot["blocks"]]
+        for i, (b, (x0, y0, x1, y1)) in enumerate(zip(shot["blocks"], boxes)):
+            inside = median_in(frame, [(x0, y0, x1, y1)], [])
+            mx, my = max(2, round((x1 - x0) * 0.25)), max(2, round((y1 - y0) * 0.25))
+            ox0, oy0, ox1, oy1 = max(0, x0 - mx), max(0, y0 - my), min(fw, x1 + mx), min(fh, y1 + my)
+            ring = [(ox0, oy0, ox1, y0), (ox0, y1, ox1, oy1), (ox0, y0, x0, y1), (x1, y0, ox1, y1)]
+            around = median_in(frame, ring, boxes)
+            if around is None:  # 块周围全被别的块占了，无从比较，跳过
+                continue
+            c = abs(inside - around) / 255
+            if c < min_contrast:
+                low.append((shot["shot"], b["label"] or f"第{i + 1}块", c))
+    return low
+
+
+def main():
+    ap = argparse.ArgumentParser(description="转灰度并检查色块明暗对比")
+    ap.add_argument("input")
+    ap.add_argument("output")
+    ap.add_argument("--board")
+    ap.add_argument("--min-contrast", type=float, default=0.25)
+    a = ap.parse_args()
+    src = need_input(a.input)
+    need_new(a.output)
+    if not 0 <= a.min_contrast <= 1:
+        raise Fail("--min-contrast 必须在 0 到 1 之间。")
+    shots = load_board(need_input(a.board)) if a.board else None
+    try:
+        gray = Image.open(src).convert("L")
+    except OSError:
+        raise Fail(f"读不出图片：{src}。")
+    low = check(gray, shots, a.min_contrast) if shots else []
+    save_image_new(gray, a.output)
+    if low:
+        print(f"明暗对比不够（阈值 {a.min_contrast:.2f}）：")
+        for shot, label, c in low:
+            print(f"{shot} {label} 对比度 {c:.3f}")
+        return 1
+    print(f"已存灰度图 {a.output}" + ("，所有色块明暗对比都够。" if shots else "。"))
+    return 0
+
+
+if __name__ == "__main__":
+    main_wrapper(main)
diff --git a/scripts/py/post.py b/scripts/py/post.py
new file mode 100644
index 0000000..dbe7423
--- /dev/null
+++ b/scripts/py/post.py
@@ -0,0 +1,169 @@
+"""后期：拼接放大、调彩度亮度、剪头尾。
+
+  post.py concat <清单txt> <输出mp4>
+      清单每行一个视频路径（相对清单所在目录），空行和 # 开头的行忽略，也认 ffmpeg 的 file '...' 写法。
+      1) 每段：输入按 BT.601 解释（-colorspace bt470bg + setparams），
+         scale=1920:1080:flags=lanczos（BT.601→BT.709 矩阵）+ unsharp=5:5:0.3，帧率统一成第一段的，
+         存成 FFV1 无损 mkv 中间文件（在输出旁的 .post-tmp-* 临时目录里，做完就删）。
+         只要有一段带声音，没声音的段补等长静音；全都没声音就不要音轨。
+      2) 按清单顺序拼接，输出 H.264（yuv420p，crf 16）+ AAC，标 bt709（colorspace/primaries/trc）。
+  post.py grade <输入> <输出> [--sat 1.0] [--bright 0.0]
+      只调彩度和亮度（eq=saturation=..:brightness=..），不动色相；输出 H.264 标 bt709。
+  post.py trim <输入> <输出> --start 秒 --end 秒
+      重编码精确剪到 [start, end)；输出 H.264 标 bt709。
+grade/trim 预期用在 concat 之后（已是 BT.709）的素材上。
+输出已存在则拒绝（退出码 2），原文件不动；ffmpeg 出错退出码 1。ffmpeg 位置见 common.py。
+"""
+import argparse
+import shutil
+import tempfile
+from pathlib import Path
+
+from common import Fail, ffmpeg, ffprobe_json, main_wrapper, need_input, need_new
+
+UPSCALE = ("scale=1920:1080:flags=lanczos:in_color_matrix=bt601:out_color_matrix=bt709"
+           ":in_range=tv:out_range=tv,unsharp=5:5:0.3")
+BT601_IN = "setparams=colorspace=bt470bg:color_primaries=bt470bg:color_trc=smpte170m:range=tv"
+BT709_TAG = "setparams=colorspace=bt709:color_primaries=bt709:color_trc=bt709:range=tv"
+H264_OUT = ["-c:v", "libx264", "-preset", "slow", "-crf", "16", "-pix_fmt", "yuv420p",
+            "-colorspace", "bt709", "-color_primaries", "bt709", "-color_trc", "bt709", "-color_range", "tv",
+            "-movflags", "+faststart"]
+AAC_OUT = ["-c:a", "aac", "-b:a", "192k", "-ar", "48000"]
+
+
+def streams(path):
+    info = ffprobe_json(path)
+    v = next((s for s in info.get("streams", []) if s.get("codec_type") == "video"), None)
+    if v is None:
+        raise Fail(f"{Path(path).name} 里没有视频流。")
+    has_audio = any(s.get("codec_type") == "audio" for s in info["streams"])
+    duration = float(v.get("duration") or info.get("format", {}).get("duration") or 0)
+    if duration <= 0:
+        raise Fail(f"读不出 {Path(path).name} 的时长。")
+    return v, has_audio, duration
+
+
+def read_list(list_path):
+    base = list_path.parent
+    clips = []
+    for raw in list_path.read_text(encoding="utf-8-sig").splitlines():
+        line = raw.strip()
+        if not line or line.startswith("#"):
+            continue
+        if line.startswith("file "):
+            line = line[5:].strip().strip("'\"")
+        p = Path(line)
+        clips.append(need_input(p if p.is_absolute() else base / p))
+    if not clips:
+        raise Fail(f"清单里没有视频：{list_path}。")
+    return clips
+
+
+def concat_escape(path):
+    return "file '" + str(path).replace("\\", "/").replace("'", "'\\''") + "'"
+
+
+def cmd_concat(a):
+    lst = need_input(a.list)
+    out = need_new(a.output)
+    clips = read_list(lst)
+    probed = [streams(c) for c in clips]
+    any_audio = any(has for _, has, _ in probed)
+    fps = probed[0][0].get("avg_frame_rate") or probed[0][0].get("r_frame_rate")
+    if not fps or fps.startswith("0/"):
+        fps = "24"
+    tmp = Path(tempfile.mkdtemp(prefix=".post-tmp-", dir=out.parent))
+    try:
+        parts = []
+        for i, (clip, (_, has_audio, dur)) in enumerate(zip(clips, probed)):
+            mid = tmp / f"part{i:03d}.mkv"
+            args = ["-colorspace", "bt470bg", "-i", clip]
+            if any_audio and not has_audio:
+                args += ["-f", "lavfi", "-t", f"{dur:.6f}", "-i", "anullsrc=r=48000:cl=stereo"]
+            args += ["-map", "0:v:0"]
+            if any_audio:
+                args += ["-map", "0:a:0" if has_audio else "1:a:0", "-af", "apad",
+                         "-c:a", "pcm_s16le", "-ar", "48000", "-ac", "2"]
+            else:
+                args += ["-an"]
+            args += ["-vf", f"{BT601_IN},fps={fps},{UPSCALE},{BT709_TAG}",
+                     "-c:v", "ffv1", "-level", "3", "-pix_fmt", "yuv420p",
+                     "-t", f"{dur:.6f}", mid]
+            ffmpeg(args, f"处理第 {i + 1} 段 {clip.name} ")
+            parts.append(mid)
+        listing = tmp / "parts.txt"
+        listing.write_text("\n".join(concat_escape(p) for p in parts) + "\n", encoding="utf-8")
+        args = ["-f", "concat", "-safe", "0", "-i", listing, "-map", "0:v:0"]
+        args += (["-map", "0:a:0", *AAC_OUT] if any_audio else ["-an"])
+        try:
+            ffmpeg([*args, *H264_OUT, out], "拼接输出")
+        except Fail:
+            out.unlink(missing_ok=True)  # 调用前已确认不存在，这里删的只会是本次的半成品
+            raise
+    finally:
+        shutil.rmtree(tmp, ignore_errors=True)
+    print(f"已拼接 {len(clips)} 段并放大到 1920×1080：{out}")
+    return 0
+
+
+def encode_simple(src, out, pre_input, vf, what):
+    _, has_audio, _ = streams(src)
+    args = [*pre_input, "-i", src, "-map", "0:v:0"]
+    args += (["-map", "0:a:0", *AAC_OUT] if has_audio else ["-an"])
+    if vf:
+        args += ["-vf", vf]
+    try:
+        ffmpeg([*args, *H264_OUT, out], what)
+    except Fail:
+        out.unlink(missing_ok=True)
+        raise
+
+
+def cmd_grade(a):
+    src = need_input(a.input)
+    out = need_new(a.output)
+    if not 0 <= a.sat <= 3:
+        raise Fail("--sat 要在 0 到 3 之间（1 为不变）。")
+    if not -1 <= a.bright <= 1:
+        raise Fail("--bright 要在 -1 到 1 之间（0 为不变）。")
+    encode_simple(src, out, [], f"eq=saturation={a.sat}:brightness={a.bright},{BT709_TAG}", "调色")
+    print(f"已调色（彩度 {a.sat}，亮度 {a.bright}）：{out}")
+    return 0
+
+
+def cmd_trim(a):
+    src = need_input(a.input)
+    out = need_new(a.output)
+    if a.start < 0 or a.end <= a.start:
+        raise Fail("--start 不能为负，--end 必须大于 --start。")
+    _, _, dur = streams(src)
+    if a.start >= dur:
+        raise Fail(f"--start {a.start} 已超过视频时长 {dur:.2f} 秒。")
+    # -ss 放在 -i 前 + 重编码：ffmpeg 会精确到帧地丢掉 start 前的画面
+    encode_simple(src, out, ["-ss", f"{a.start:.6f}", "-t", f"{a.end - a.start:.6f}"], BT709_TAG, "剪辑")
+    print(f"已剪出 {a.start}–{a.end} 秒：{out}")
+    return 0
+
+
+def main():
+    ap = argparse.ArgumentParser(description="拼接放大、调色、剪辑")
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    c = sub.add_parser("concat")
+    c.add_argument("list")
+    c.add_argument("output")
+    g = sub.add_parser("grade")
+    g.add_argument("input")
+    g.add_argument("output")
+    g.add_argument("--sat", type=float, default=1.0)
+    g.add_argument("--bright", type=float, default=0.0)
+    t = sub.add_parser("trim")
+    t.add_argument("input")
+    t.add_argument("output")
+    t.add_argument("--start", type=float, required=True)
+    t.add_argument("--end", type=float, required=True)
+    a = ap.parse_args()
+    return {"concat": cmd_concat, "grade": cmd_grade, "trim": cmd_trim}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main_wrapper(main)
