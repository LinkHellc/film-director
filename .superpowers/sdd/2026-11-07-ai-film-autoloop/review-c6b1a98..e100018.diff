new file mode 100644
index 0000000..018a069
--- /dev/null
+++ b/scripts/py/sketch.py
@@ -0,0 +1,150 @@
+"""色块草图总表。
+
+用法：python sketch.py <分镜JSON> <输出png>
+
+分镜 JSON：
+  [{"shot": "S01", "bg": "#1d2a3a",
+    "blocks": [{"x": 0.62, "y": 0.4, "w": 0.1, "h": 0.5, "color": "#c0392b", "label": "邮差"}]}]
+x/y/w/h 都是占画面宽/高的比例，(x, y) 是色块左上角；label 可省略，可以是中文。
+
+每镜先按 1920×1080 画：背景色、色块、标签，再在 x=38% 和 x=62% 画黄金分割竖线；
+然后缩到 640×360，镜头号写在左上角，每行 3 张拼成总表（宽固定 1920，空位填深灰）。
+输出已存在则拒绝（退出码 2），原文件不动。
+"""
+import json
+import math
+import sys
+from pathlib import Path
+
+from PIL import Image, ImageColor, ImageDraw, ImageFont
+
+from common import Fail, main_wrapper, need_input, need_new, save_image_new
+
+FRAME_W, FRAME_H = 1920, 1080
+TILE_W, TILE_H = 640, 360
+COLS = 3
+GUIDES = (0.38, 0.62)
+GUIDE_COLOR = (255, 214, 0)
+EMPTY_COLOR = (40, 40, 40)
+FONT_CANDIDATES = [
+    "C:/Windows/Fonts/msyh.ttc",
+    "C:/Windows/Fonts/simhei.ttf",
+    "C:/Windows/Fonts/Deng.ttf",
+    "/System/Library/Fonts/PingFang.ttc",
+    "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
+]
+
+
+def load_font(size):
+    """找一个能写中文的字体；都没有就退回 Pillow 自带字体（中文可能显示成方块，但不报错）。"""
+    for path in FONT_CANDIDATES:
+        try:
+            return ImageFont.truetype(path, size)
+        except OSError:
+            continue
+    try:
+        return ImageFont.load_default(size=size)
+    except TypeError:
+        return ImageFont.load_default()
+
+
+def color(value, where):
+    try:
+        return ImageColor.getrgb(value)
+    except (ValueError, AttributeError):
+        raise Fail(f"{where} 的颜色写法不对：{value!r}。")
+
+
+def frac(block, key, where):
+    v = block.get(key)
+    if not isinstance(v, (int, float)) or isinstance(v, bool) or not 0 <= v <= 1:
+        raise Fail(f"{where} 的 {key} 必须是 0 到 1 之间的数。")
+    return float(v)
+
+
+def load_board(path):
+    try:
+        data = json.loads(Path(path).read_text(encoding="utf-8"))
+    except (json.JSONDecodeError, UnicodeDecodeError) as e:
+        raise Fail(f"分镜 JSON 读不出来：{e}。")
+    if not isinstance(data, list) or not data:
+        raise Fail("分镜 JSON 必须是非空数组，每项是一个镜头。")
+    shots = []
+    for i, s in enumerate(data):
+        if not isinstance(s, dict) or not isinstance(s.get("shot"), str):
+            raise Fail(f"第 {i + 1} 个镜头缺少 shot 名。")
+        name = s["shot"]
+        blocks = s.get("blocks", [])
+        if not isinstance(blocks, list):
+            raise Fail(f"{name} 的 blocks 必须是数组。")
+        parsed = []
+        for j, b in enumerate(blocks):
+            where = f"{name} 第 {j + 1} 个色块"
+            if not isinstance(b, dict):
+                raise Fail(f"{where} 必须是对象。")
+            parsed.append({
+                "x": frac(b, "x", where), "y": frac(b, "y", where),
+                "w": frac(b, "w", where), "h": frac(b, "h", where),
+                "color": color(b.get("color"), where),
+                "label": str(b.get("label") or ""),
+            })
+        shots.append({"shot": name, "bg": color(s.get("bg", "#000000"), name), "blocks": parsed})
+    return shots
+
+
+def block_box(b, w, h):
+    """色块在 w×h 画面里的像素框 (x0, y0, x1, y1)，右下不含，裁在画面内。"""
+    x0, y0 = round(b["x"] * w), round(b["y"] * h)
+    x1, y1 = round(min(1.0, b["x"] + b["w"]) * w), round(min(1.0, b["y"] + b["h"]) * h)
+    return x0, y0, max(x0 + 1, x1), max(y0 + 1, y1)
+
+
+def draw_guides(img, width):
+    d = ImageDraw.Draw(img)
+    w, h = img.size
+    for g in GUIDES:
+        x = round(g * w)
+        d.rectangle((x - width // 2, 0, x - width // 2 + width - 1, h), fill=GUIDE_COLOR)
+
+
+def render_shot(shot, font):
+    img = Image.new("RGB", (FRAME_W, FRAME_H), shot["bg"])
+    d = ImageDraw.Draw(img)
+    for b in shot["blocks"]:
+        x0, y0, x1, y1 = block_box(b, FRAME_W, FRAME_H)
+        d.rectangle((x0, y0, x1 - 1, y1 - 1), fill=b["color"])
+        if b["label"]:
+            d.text(((x0 + x1) / 2, (y0 + y1) / 2), b["label"], font=font, fill="white",
+                   anchor="mm", stroke_width=4, stroke_fill="black")
+    draw_guides(img, 6)
+    return img
+
+
+def build_sheet(shots):
+    rows = math.ceil(len(shots) / COLS)
+    sheet = Image.new("RGB", (TILE_W * COLS, TILE_H * rows), EMPTY_COLOR)
+    label_font, tag_font = load_font(64), load_font(28)
+    for i, shot in enumerate(shots):
+        tile = render_shot(shot, label_font).resize((TILE_W, TILE_H), Image.LANCZOS)
+        draw_guides(tile, 2)  # 缩小后重画一遍，保证竖线清楚、颜色纯
+        d = ImageDraw.Draw(tile)
+        box = d.textbbox((10, 6), shot["shot"], font=tag_font)
+        d.rectangle((box[0] - 6, box[1] - 4, box[2] + 6, box[3] + 4), fill=(0, 0, 0))
+        d.text((10, 6), shot["shot"], font=tag_font, fill="white")
+        sheet.paste(tile, ((i % COLS) * TILE_W, (i // COLS) * TILE_H))
+    return sheet
+
+
+def main():
+    if len(sys.argv) != 3:
+        raise Fail("用法：sketch.py <分镜JSON> <输出png>。")
+    board_path, out = need_input(sys.argv[1]), sys.argv[2]
+    need_new(out)
+    shots = load_board(board_path)
+    save_image_new(build_sheet(shots), out)
+    print(f"已画 {len(shots)} 个镜头的草图总表：{out}")
+    return 0
+
+
+if __name__ == "__main__":
+    main_wrapper(main)
diff --git a/scripts/quote.ts b/scripts/quote.ts
new file mode 100644
index 0000000..f83465b
--- /dev/null
+++ b/scripts/quote.ts
@@ -0,0 +1,233 @@
+import { readFileSync, readdirSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { filmDir } from "./lib/paths.ts";
+import { readState } from "./lib/state.ts";
+import { writeNew } from "./lib/versioned.ts";
+import { sha256File } from "./lib/hash.ts";
+
+export type Model = "mini" | "2.5";
+
+export interface Quote {
+  id: string;
+  film: string;
+  model: Model;
+  modelId: string;
+  shots: { shot: string; seconds: number; billable: number; reviewHash: string }[];
+  totalCNY: number;
+  spentCNY: number;
+  budgetCNY: number;
+  overBudget: boolean;
+  createdAt: string;
+}
+
+export interface Pricing {
+  default: Model;
+  models: Record<Model, { id: string; cnyPerSecond720p: number; firstLastFrame?: boolean }>;
+}
+
+/** spend.jsonl 的一行。submit 写 {at,quote,shot,task,model,billable,cny}；结果不明时 task 为 null 且 uncertain 为 true。 */
+export interface SpendRow {
+  at?: string;
+  quote?: string;
+  shot?: string;
+  task?: string | null;
+  model?: string;
+  billable?: number;
+  cny: number;
+  uncertain?: boolean;
+}
+
+const USAGE = "用法：quote.ts <片名> --shots S01,S02 [--model mini|2.5]";
+const EPS = 1e-9;
+
+/** 价格表属于代码仓库，按本文件位置定位（与 FILM_ROOT 无关）。 */
+export function readPricing(): Pricing {
+  const path = resolve(dirname(fileURLToPath(import.meta.url)), "..", "config", "pricing.json");
+  return JSON.parse(readFileSync(path, "utf8")) as Pricing;
+}
+
+export function round1(x: number): number {
+  return Math.round(x * 10) / 10;
+}
+
+function listNames(dir: string): string[] {
+  try {
+    return readdirSync(dir);
+  } catch (err) {
+    if ((err as NodeJS.ErrnoException).code === "ENOENT") return [];
+    throw err;
+  }
+}
+
+/**
+ * 计费秒数：向上取整；余量不足（含等于）0.5 秒再加 1 秒；最少 4 秒。秒数必须是大于 0 的有限数。
+ * 4 秒下限：网关文档写明 seedance-2.0-mini 4–15 秒、seedance-2.5 4–30 秒，seconds 是整数，
+ * 费用 = 输出秒数 × 单价（来源见 scripts/lib/video-api.ts 顶部注释）。上限因模型而异，超了网关返回 400（不建任务、不扣费）。
+ */
+export function billableSeconds(seconds: number): number {
+  if (typeof seconds !== "number" || !Number.isFinite(seconds) || seconds <= 0) {
+    throw new Error(`秒数不合法：${seconds}`);
+  }
+  let n = Math.ceil(seconds - EPS);
+  if (n - seconds <= 0.5 + EPS) n += 1;
+  return Math.max(n, 4);
+}
+
+/** 镜头最新（n 最大，按数字比较）的 pre-submit 审核记录路径；没有返回 null。 */
+export function latestReviewPath(dir: string, shot: string): string | null {
+  const esc = shot.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+  const re = new RegExp(`^pre-submit-${esc}-v(\\d+)\\.json$`);
+  let best = 0;
+  for (const name of listNames(join(dir, "reviews"))) {
+    const m = re.exec(name);
+    if (m) best = Math.max(best, Number(m[1]));
+  }
+  return best === 0 ? null : join(dir, "reviews", `pre-submit-${shot}-v${best}.json`);
+}
+
+/** 镜头最新的 pre-submit 审核文件；必须 verdict 为 pass，返回其哈希。 */
+function passedReviewHash(dir: string, shot: string): string {
+  const fail = new Error(`${shot} 还没有通过提交前审核`);
+  const path = latestReviewPath(dir, shot);
+  if (path === null) throw fail;
+  const review = JSON.parse(readFileSync(path, "utf8")) as { verdict?: string };
+  if (review.verdict !== "pass") throw fail;
+  return sha256File(path);
+}
+
+/** spend.jsonl 的全部行；文件不存在为 []；坏行（不是 JSON、cny 不是非负有限数）抛错。 */
+export function readSpendRows(dir: string): SpendRow[] {
+  let raw: string;
+  try {
+    raw = readFileSync(join(dir, "spend.jsonl"), "utf8");
+  } catch (err) {
+    if ((err as NodeJS.ErrnoException).code === "ENOENT") return [];
+    throw err;
+  }
+  const rows: SpendRow[] = [];
+  const lines = raw.split(/\r?\n/);
+  for (let i = 0; i < lines.length; i++) {
+    if (!lines[i].trim()) continue;
+    let row: { cny?: unknown } | null;
+    try {
+      row = JSON.parse(lines[i]);
+    } catch {
+      throw new Error(`spend.jsonl 第 ${i + 1} 行不是合法的 JSON`);
+    }
+    const cny = row?.cny;
+    if (typeof cny !== "number" || !Number.isFinite(cny) || cny < 0) {
+      throw new Error(`spend.jsonl 第 ${i + 1} 行的 cny 不合法：${JSON.stringify(cny)}`);
+    }
+    rows.push(row as SpendRow);
+  }
+  return rows;
+}
+
+/** spend.jsonl 各行 cny 之和（不四舍五入）；文件不存在为 0；坏行抛错。 */
+export function spentFromLog(dir: string): number {
+  return readSpendRows(dir).reduce((a, r) => a + r.cny, 0);
+}
+
+function nextQuoteId(dir: string): string {
+  let max = 0;
+  for (const name of listNames(join(dir, "quotes"))) {
+    const m = /^Q(\d+)\.json$/.exec(name);
+    if (m) max = Math.max(max, Number(m[1]));
+  }
+  return `Q${max + 1}`;
+}
+
+export function buildQuote(film: string, shots: string[], model?: Model): Quote {
+  const dir = filmDir(film);
+  const state = readState(film);
+  const pricing = readPricing();
+  const m: Model = model ?? state.settings.model ?? pricing.default;
+  const price = pricing.models[m];
+  if (!price) throw new Error(`没有这个模型：${m}`);
+  if (shots.length === 0) throw new Error("没有指定镜头");
+  const seen = new Set<string>();
+  for (const s of shots) {
+    if (seen.has(s)) throw new Error(`镜头重复：${s}`);
+    seen.add(s);
+    if (!Object.hasOwn(state.shots, s)) throw new Error(`没有这个镜头：${s}`);
+  }
+  const budget = state.settings.budgetCNY;
+  if (budget === null || budget === undefined) throw new Error("还没有设总预算");
+  if (typeof budget !== "number" || !Number.isFinite(budget) || budget < 0) {
+    throw new Error(`总预算不合法：${JSON.stringify(budget)}`);
+  }
+
+  const lines = shots.map((shot) => {
+    const seconds = state.shots[shot].seconds;
+    let billable: number;
+    try {
+      billable = billableSeconds(seconds);
+    } catch {
+      throw new Error(`${shot} 的秒数不合法：${JSON.stringify(seconds)}`);
+    }
+    return { shot, seconds, billable, reviewHash: passedReviewHash(dir, shot) };
+  });
+  const rawTotal = lines.reduce((a, l) => a + l.billable, 0) * price.cnyPerSecond720p;
+  if (!Number.isFinite(rawTotal)) throw new Error(`单价不合法：${m}`);
+  const rawSpent = spentFromLog(dir);
+  return {
+    id: nextQuoteId(dir),
+    film,
+    model: m,
+    modelId: price.id,
+    shots: lines,
+    totalCNY: round1(rawTotal),
+    spentCNY: round1(rawSpent),
+    budgetCNY: budget,
+    // 用未四舍五入的数比较；写成 !(<=)，任何 NaN 都算超预算（失败即关）。
+    overBudget: !(rawSpent + rawTotal <= budget + EPS),
+    createdAt: new Date().toISOString(),
+  };
+}
+
+function human(p: string): string {
+  return p.replace(/\\/g, "/");
+}
+
+export async function main(argv: string[]): Promise<number> {
+  const [film, ...rest] = argv;
+  let shotsArg: string | undefined;
+  let modelArg: string | undefined;
+  for (let i = 0; i < rest.length; i++) {
+    if (rest[i] === "--shots") shotsArg = rest[++i];
+    else if (rest[i] === "--model") modelArg = rest[++i];
+    else {
+      console.error(USAGE);
+      return 2;
+    }
+  }
+  if (!film || !shotsArg || (modelArg !== undefined && modelArg !== "mini" && modelArg !== "2.5")) {
+    console.error(USAGE);
+    return 2;
+  }
+  const shots = shotsArg.split(",").map((s) => s.trim()).filter(Boolean);
+
+  let q: Quote;
+  try {
+    q = buildQuote(film, shots, modelArg as Model | undefined);
+  } catch (err) {
+    console.error((err as Error).message);
+    return 2;
+  }
+  const path = join(filmDir(film), "quotes", `${q.id}.json`);
+  writeNew(path, JSON.stringify(q, null, 2) + "\n");
+
+  const secs = q.shots.reduce((a, s) => a + s.billable, 0);
+  const sentence =
+    `报价 ${q.id}：${q.shots.length} 镜 ${secs} 秒 ${q.model} 约 ¥${q.totalCNY.toFixed(1)}（估算，以账单为准）；` +
+    `已花 ¥${q.spentCNY.toFixed(1)}，预算余 ¥${round1(q.budgetCNY - q.spentCNY).toFixed(1)}`;
+  if (q.overBudget) {
+    console.error(`超预算：${sentence}（已写 ${human(path)}，不能提交）`);
+    return 2;
+  }
+  console.log(sentence);
+  return 0;
+}
+
+if (import.meta.main) process.exit(await main(process.argv.slice(2)));
