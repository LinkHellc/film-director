+++ b/tests/lib.test.ts
@@ -0,0 +1,95 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, writeFileSync, readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, basename, resolve } from "node:path";
+import { projectRoot, filmDir, assertFilmName } from "../scripts/lib/paths.ts";
+import { nextVersionPath, writeNew } from "../scripts/lib/versioned.ts";
+import { sha256File } from "../scripts/lib/hash.ts";
+
+function tempDir(): string {
+  return mkdtempSync(join(tmpdir(), "film-lib-"));
+}
+
+test("nextVersionPath 空目录返回 v1", () => {
+  const dir = tempDir();
+  try {
+    const p = nextVersionPath(dir, "plan", "md");
+    assert.equal(basename(p), "plan-v1.md");
+    assert.equal(resolve(p), resolve(join(dir, "plan-v1.md")));
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("nextVersionPath 已有 v1、v3 时返回 v4，忽略其他文件", () => {
+  const dir = tempDir();
+  try {
+    writeFileSync(join(dir, "plan-v1.md"), "a");
+    writeFileSync(join(dir, "plan-v3.md"), "b");
+    writeFileSync(join(dir, "plan-v9.txt"), "other ext");
+    writeFileSync(join(dir, "xplan-v7.md"), "other base");
+    assert.equal(basename(nextVersionPath(dir, "plan", "md")), "plan-v4.md");
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("writeNew 写已存在文件时抛错且原内容不变", () => {
+  const dir = tempDir();
+  try {
+    const p = join(dir, "a.txt");
+    writeNew(p, "原内容");
+    assert.equal(readFileSync(p, "utf8"), "原内容");
+    assert.throws(() => writeNew(p, "新内容"));
+    assert.equal(readFileSync(p, "utf8"), "原内容");
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("assertFilmName 合法与不合法", () => {
+  assert.doesNotThrow(() => assertFilmName("雨夜邮差"));
+  assert.throws(() => assertFilmName("../x"), { message: "片名不合法：../x" });
+  assert.throws(() => assertFilmName(""), { message: "片名不合法：" });
+});
+
+test("projectRoot 优先用 FILM_ROOT，filmDir 位于 films/<片名>", () => {
+  const dir = tempDir();
+  const old = process.env.FILM_ROOT;
+  try {
+    process.env.FILM_ROOT = dir;
+    assert.equal(projectRoot(), resolve(dir));
+    assert.equal(filmDir("雨夜邮差"), join(resolve(dir), "films", "雨夜邮差"));
+    assert.throws(() => filmDir("../x"), { message: "片名不合法：../x" });
+  } finally {
+    if (old === undefined) delete process.env.FILM_ROOT;
+    else process.env.FILM_ROOT = old;
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("未设 FILM_ROOT 时 projectRoot 为仓库根（与 cwd 无关）", () => {
+  const old = process.env.FILM_ROOT;
+  try {
+    delete process.env.FILM_ROOT;
+    const repoRoot = resolve(import.meta.dirname, "..");
+    assert.equal(projectRoot(), repoRoot);
+  } finally {
+    if (old !== undefined) process.env.FILM_ROOT = old;
+  }
+});
+
+test("sha256File 对 abc 返回小写十六进制", () => {
+  const dir = tempDir();
+  try {
+    const p = join(dir, "abc.txt");
+    writeFileSync(p, "abc");
+    assert.equal(
+      sha256File(p),
+      "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
+    );
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
diff --git a/tests/new-film.test.ts b/tests/new-film.test.ts
new file mode 100644
index 0000000..7993ac6
--- /dev/null
+++ b/tests/new-film.test.ts
@@ -0,0 +1,159 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, mkdirSync, writeFileSync, readFileSync, readdirSync, rmSync, existsSync, statSync } from "node:fs";
+import { createServer, type IncomingMessage } from "node:http";
+import type { AddressInfo } from "node:net";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { main } from "../scripts/new-film.ts";
+import { readState } from "../scripts/lib/state.ts";
+
+const SUBDIRS = ["story", "board", "style", "shots", "reviews", "quotes", "approvals", "post", "out"];
+const ENV_KEYS = ["FILM_ROOT", "AGENT_AUTOLOOP_URL", "AGENT_AUTOLOOP_FILM_KEY"] as const;
+
+/** 临时 FILM_ROOT + 环境变量保存/恢复 + 捕获 console 输出。 */
+async function withEnv(
+  env: Partial<Record<(typeof ENV_KEYS)[number], string | undefined>>,
+  fn: (root: string, out: string[]) => Promise<void>,
+): Promise<void> {
+  const root = mkdtempSync(join(tmpdir(), "film-new-"));
+  const saved = Object.fromEntries(ENV_KEYS.map((k) => [k, process.env[k]]));
+  const out: string[] = [];
+  const log = console.log;
+  const err = console.error;
+  console.log = (...a: unknown[]) => void out.push(a.join(" "));
+  console.error = (...a: unknown[]) => void out.push(a.join(" "));
+  try {
+    process.env.FILM_ROOT = root;
+    for (const k of ["AGENT_AUTOLOOP_URL", "AGENT_AUTOLOOP_FILM_KEY"] as const) {
+      if (env[k] === undefined) delete process.env[k];
+      else process.env[k] = env[k];
+    }
+    await fn(root, out);
+  } finally {
+    console.log = log;
+    console.error = err;
+    for (const k of ENV_KEYS) {
+      if (saved[k] === undefined) delete process.env[k];
+      else process.env[k] = saved[k];
+    }
+    rmSync(root, { recursive: true, force: true });
+  }
+}
+
+const IDEA = "一个雨夜邮差把最后一封信送给了自己。";
+
+test("--no-emit 建出全部目录和三个文件，stage 为 setup", async () => {
+  await withEnv({}, async (root) => {
+    const code = await main(["测试片", IDEA, "--no-emit"]);
+    assert.equal(code, 0);
+    const dir = join(root, "films", "测试片");
+    for (const d of SUBDIRS) assert.ok(statSync(join(dir, d)).isDirectory(), d);
+    assert.equal(readFileSync(join(dir, "brief.md"), "utf8").trim(), IDEA);
+    const req = readFileSync(join(dir, "requirements.md"), "utf8").split(/\r?\n/);
+    assert.equal(req[0], "# 本人要求");
+    const firstItem = req.find((l) => l.startsWith("- "));
+    assert.equal(firstItem, `- ${IDEA}`);
+    const s = readState("测试片");
+    assert.equal(s.film, "测试片");
+    assert.equal(s.stage, "setup");
+    assert.deepEqual(s.settings, {
+      seconds: null, aspect: "16:9", budgetCNY: null, music: null, subtitles: false, model: "mini",
+    });
+    assert.deepEqual(s.gates, {});
+    assert.deepEqual(s.shots, {});
+    assert.equal(s.spentCNY, 0);
+  });
+});
+
+test("片子目录已存在时返回非零且不改动已有文件", async () => {
+  await withEnv({}, async (root, out) => {
+    const dir = join(root, "films", "测试片");
+    mkdirSync(dir, { recursive: true });
+    writeFileSync(join(dir, "brief.md"), "旧想法");
+    const code = await main(["测试片", IDEA, "--no-emit"]);
+    assert.notEqual(code, 0);
+    assert.equal(readFileSync(join(dir, "brief.md"), "utf8"), "旧想法");
+    assert.deepEqual(readdirSync(dir), ["brief.md"]);
+    assert.match(out.join("\n"), /已存在/);
+  });
+});
+
+test("片名不合法或缺参数时返回非零且不建目录", async () => {
+  await withEnv({}, async (root, out) => {
+    assert.notEqual(await main(["../x", IDEA, "--no-emit"]), 0);
+    assert.match(out.join("\n"), /片名不合法：\.\.\/x/);
+    assert.notEqual(await main(["测试片"]), 0);
+    assert.equal(existsSync(join(root, "films", "测试片")), false);
+  });
+});
+
+test("发事件到假中台：subject、Authorization 和事件体正确", async () => {
+  const got: { auth?: string; url?: string; method?: string; body?: any } = {};
+  const server = createServer((req: IncomingMessage, res) => {
+    let raw = "";
+    req.setEncoding("utf8");
+    req.on("data", (c) => (raw += c));
+    req.on("end", () => {
+      got.auth = req.headers.authorization;
+      got.url = req.url;
+      got.method = req.method;
+      got.body = JSON.parse(raw);
+      res.writeHead(200, { "content-type": "application/json" });
+      res.end(JSON.stringify({ event: 7, duplicate: false, routed: [] }));
+    });
+  });
+  await new Promise<void>((r) => server.listen(0, "127.0.0.1", r));
+  const port = (server.address() as AddressInfo).port;
+  try {
+    const longIdea = "长".repeat(250);
+    await withEnv(
+      { AGENT_AUTOLOOP_URL: `http://127.0.0.1:${port}`, AGENT_AUTOLOOP_FILM_KEY: "k-test-123" },
+      async (root, out) => {
+        const code = await main(["测试片", longIdea]);
+        assert.equal(code, 0);
+        assert.equal(got.method, "POST");
+        assert.equal(got.url, "/v1/events");
+        assert.equal(got.auth, "Bearer k-test-123");
+        assert.equal(got.body.subject, "film:测试片");
+        assert.equal(got.body.id, "film.new:测试片");
+        assert.equal(got.body.type, "film.new");
+        assert.equal(got.body.summary, "长".repeat(200));
+        assert.ok(existsSync(join(root, "films", "测试片", "state.json")));
+        assert.match(out.join("\n"), /事件 7/);
+      },
+    );
+  } finally {
+    await new Promise<void>((r) => server.close(() => r()));
+  }
+});
+
+test("没设 AGENT_AUTOLOOP_FILM_KEY 时目录照建，退出码非零并说明原因", async () => {
+  await withEnv({ AGENT_AUTOLOOP_URL: "http://127.0.0.1:9" }, async (root, out) => {
+    const code = await main(["测试片", IDEA]);
+    assert.notEqual(code, 0);
+    assert.ok(existsSync(join(root, "films", "测试片", "state.json")));
+    assert.match(out.join("\n"), /没有发出事件：缺少 AGENT_AUTOLOOP_FILM_KEY/);
+  });
+});
+
+test("中台返回非 200 时退出码非零并说明没有发出事件", async () => {
+  const server = createServer((_req, res) => {
+    res.writeHead(401);
+    res.end("no");
+  });
+  await new Promise<void>((r) => server.listen(0, "127.0.0.1", r));
+  const port = (server.address() as AddressInfo).port;
+  try {
+    await withEnv(
+      { AGENT_AUTOLOOP_URL: `http://127.0.0.1:${port}`, AGENT_AUTOLOOP_FILM_KEY: "bad" },
+      async (_root, out) => {
+        const code = await main(["测试片", IDEA]);
+        assert.notEqual(code, 0);
+        assert.match(out.join("\n"), /没有发出事件：.*401/);
+      },
+    );
+  } finally {
+    await new Promise<void>((r) => server.close(() => r()));
+  }
+});
diff --git a/tests/proc.test.ts b/tests/proc.test.ts
new file mode 100644
index 0000000..bb6a5eb
--- /dev/null
+++ b/tests/proc.test.ts
@@ -0,0 +1,85 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { resolveCommand, run } from "../scripts/lib/proc.ts";
+
+function withTmp(fn: (dir: string) => Promise<void> | void): Promise<void> {
+  const dir = mkdtempSync(join(tmpdir(), "film-proc-"));
+  return Promise.resolve(fn(dir)).finally(() => rmSync(dir, { recursive: true, force: true }));
+}
+
+function withEnv(vars: Record<string, string | undefined>, fn: () => void): void {
+  const saved = Object.fromEntries(Object.keys(vars).map((k) => [k, process.env[k]]));
+  try {
+    for (const [k, v] of Object.entries(vars)) {
+      if (v === undefined) delete process.env[k];
+      else process.env[k] = v;
+    }
+    fn();
+  } finally {
+    for (const [k, v] of Object.entries(saved)) {
+      if (v === undefined) delete process.env[k];
+      else process.env[k] = v;
+    }
+  }
+}
+
+test("resolveCommand: env JSON array wins over fallback", () => {
+  withEnv({ FILM_TEST_CMD: JSON.stringify([process.execPath, "x.js", "--flag"]) }, () => {
+    assert.deepEqual(resolveCommand("FILM_TEST_CMD", ["nope"]), [process.execPath, "x.js", "--flag"]);
+  });
+});
+
+test("resolveCommand: bad env value throws", () => {
+  for (const bad of ["codex", "[]", "[1]", '{"a":1}']) {
+    withEnv({ FILM_TEST_CMD: bad }, () => {
+      assert.throws(() => resolveCommand("FILM_TEST_CMD", ["x"]), /FILM_TEST_CMD/);
+    });
+  }
+});
+
+test("resolveCommand: npm .cmd shim on PATH resolves to node + js entry", { skip: process.platform !== "win32" }, async () => {
+  await withTmp((dir) => {
+    mkdirSync(join(dir, "node_modules", "fake", "bin"), { recursive: true });
+    const js = join(dir, "node_modules", "fake", "bin", "fake.js");
+    writeFileSync(js, "");
+    writeFileSync(
+      join(dir, "fakecli.cmd"),
+      '@ECHO off\r\nSETLOCAL\r\nCALL :find_dp0\r\nendLocal & goto #_undefined_# 2>NUL || title %COMSPEC% & "%_prog%"  "%dp0%\\node_modules\\fake\\bin\\fake.js" %*\r\n',
+    );
+    withEnv({ FILM_TEST_CMD: undefined, PATH: `${dir};${process.env.PATH}` }, () => {
+      assert.deepEqual(resolveCommand("FILM_TEST_CMD", ["fakecli", "--x"]), [process.execPath, js, "--x"]);
+    });
+  });
+});
+
+test("run: passes stdin, captures stdout/stderr and exit code, no shell interpretation", async () => {
+  const script = [
+    "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{",
+    "process.stdout.write(JSON.stringify({argv:process.argv.slice(1),stdin:s}));",
+    "process.stderr.write('err');process.exit(3);});",
+  ].join("");
+  const tricky = ['a & echo pwned', '"quoted"', "%PATH%", "^|<>", "中文 参数"];
+  const r = await run([process.execPath, "-e", script, ...tricky], { stdin: "提示词 & stuff\n" });
+  assert.equal(r.code, 3);
+  assert.equal(r.stderr, "err");
+  const got = JSON.parse(r.stdout);
+  assert.deepEqual(got.argv, tricky);
+  assert.equal(got.stdin, "提示词 & stuff\n");
+});
+
+test("run: missing program returns non-zero instead of throwing", async () => {
+  const r = await run(["definitely-not-a-program-xyz"], {});
+  assert.notEqual(r.code, 0);
+  assert.match(r.stderr, /definitely-not-a-program-xyz/);
+});
+
+test("run: timeout kills the child", async () => {
+  const t = Date.now();
+  const r = await run([process.execPath, "-e", "setTimeout(()=>{},60000)"], { timeoutMs: 300 });
+  assert.notEqual(r.code, 0);
+  assert.match(r.stderr, /超时/);
+  assert.ok(Date.now() - t < 10_000);
+});
