+test("wait --timeout 1：还没出完 → 退出 6", async () => {
+  await withFilm({ shots: ["S01"], gw: { succeedAfter: 100000 } }, async (c) => {
+    const id = await quoteAndApprove("S01");
+    assert.equal(await main(["submit", FILM, "--quote", id]), 0);
