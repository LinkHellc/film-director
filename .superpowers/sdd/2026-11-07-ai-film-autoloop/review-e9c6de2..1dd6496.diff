   }
-  let max = 0;
+  let best = { n: 0, name: null as string | null };
   for (const name of names) {
     const m = re.exec(name);
-    if (m) max = Math.max(max, Number(m[1]));
+    if (m && Number(m[1]) > best.n) best = { n: Number(m[1]), name };
   }
-  return join(dir, `${base}-v${max + 1}.${ext}`);
